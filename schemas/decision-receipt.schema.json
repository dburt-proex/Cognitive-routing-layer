{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "decision-receipt.schema.json",
  "title": "Reasoning Control Plane Decision Receipt",
  "description": "The durable output of a run and the artifact the Shared Decision Ledger persists. It records how a recommendation was produced: the computed classification and its provenance, the selected route and why each operator was chosen, the evidence used and its verification state, contradictions, missing evidence, confidence by operator, the mandatory audit, and an authorization status that is structurally independent of confidence. It contains structured conclusions only; private chain-of-thought is never stored.",
  "type": "object",
  "required": [
    "receipt_version",
    "run_id",
    "run_timestamp",
    "problem_statement",
    "normalized_intake_hash",
    "signals",
    "classification",
    "versions",
    "route",
    "evidence_used",
    "operator_conclusions",
    "assumptions",
    "contradictions",
    "missing_evidence",
    "confidence_by_operator",
    "convergence",
    "metacognitive_audit",
    "gate",
    "recommendation",
    "risks",
    "authorization",
    "execution",
    "review_requirements",
    "next_action",
    "stage_chain",
    "stage_chain_head",
    "record_id"
  ],
  "properties": {
    "receipt_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "run_id": {"type": "string", "pattern": "^RCP-RUN-[0-9]{4}-[0-9]{4}$"},
    "run_timestamp": {"type": "string", "format": "date-time"},
    "problem_statement": {"type": "string", "minLength": 20},
    "normalized_intake_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "signals": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "classification": {
      "type": "object",
      "required": ["task_class", "classification_source", "classification_policy_version", "rejected_classifications", "deterministic_basis", "caller_proposal_honored"],
      "properties": {
        "task_class": {"enum": ["PRIORITIZATION", "DIAGNOSTIC", "DESIGN", "GOVERNANCE_EVALUATION", "CHANGE_RISK", "STRATEGY", "UNSUPPORTED"]},
        "classification_source": {"enum": ["computed"]},
        "classification_policy_id": {"type": "string"},
        "classification_policy_version": {"type": "string"},
        "activated_rule_id": {"type": ["string", "null"]},
        "rejected_classifications": {"type": "array", "items": {"type": "object"}},
        "deterministic_basis": {"type": "string", "minLength": 10},
        "caller_proposed_classification": {"type": ["string", "null"]},
        "caller_proposal_honored": {"type": "boolean"},
        "caller_proposal_mismatch": {"type": "boolean"},
        "manual_override": {"type": ["string", "null"]},
        "manual_override_owner": {"type": ["string", "null"]},
        "manual_override_reason": {"type": ["string", "null"]}
      }
    },
    "versions": {
      "type": "object",
      "required": ["policy_id", "policy_version", "operator_registry_id", "operator_registry_version", "operator_registry_sha256", "routing_policy_sha256"],
      "properties": {
        "policy_id": {"type": "string"},
        "policy_version": {"type": "string"},
        "operator_registry_id": {"type": "string"},
        "operator_registry_version": {"type": "string"},
        "operator_registry_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "routing_policy_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "route": {"type": "object"},
    "option_set": {
      "type": "array",
      "description": "Every option the run considered, with its origin. An option generated by an EXPLORE operator is ranked and rejected on the record like any supplied option.",
      "items": {
        "type": "object",
        "required": ["option_id", "label", "origin"],
        "properties": {
          "option_id": {"type": "string"},
          "label": {"type": "string"},
          "origin": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "evidence_used": {"type": "array", "items": {"type": "object"}},
    "operator_conclusions": {"type": "array", "items": {"type": "object"}},
    "assumptions": {"type": "array", "items": {"type": "object"}},
    "contradictions": {"type": "array", "items": {"type": "object"}},
    "missing_evidence": {"type": "array", "items": {"type": "object"}},
    "confidence_by_operator": {"type": "array", "items": {"type": "object"}},
    "convergence": {
      "type": "object",
      "required": ["ranking", "selected_option_id", "rejected_alternatives", "decision_confidence", "decision_confidence_label"],
      "properties": {
        "ranking": {"type": "array", "items": {"type": "object"}},
        "selected_option_id": {"type": ["string", "null"]},
        "rejected_alternatives": {"type": "array", "items": {"type": "object"}},
        "tie_candidates": {"type": "array", "items": {"type": "string"}},
        "selection_reason": {"type": "string"},
        "decision_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "decision_confidence_basis": {"type": "string"},
        "decision_confidence_label": {"enum": ["uncalibrated_decision_support_score"]},
        "thresholds_applied": {"type": "object"}
      }
    },
    "metacognitive_audit": {
      "type": "object",
      "required": ["operator_id", "audit_result", "findings", "coverage"],
      "properties": {
        "operator_id": {"enum": ["metacognitive"]},
        "audit_result": {"enum": ["PASS", "FAIL"]},
        "findings": {"type": "array", "items": {"type": "object"}},
        "material_finding_count": {"type": "integer", "minimum": 0},
        "phases": {"type": "array", "items": {"type": "object"}},
        "coverage": {"type": "object"},
        "declared_confidence": {"type": "string"},
        "stage_chain_head": {"type": "string"}
      }
    },
    "gate": {
      "type": "object",
      "required": ["gate_result", "gate_reasons", "confidence_threshold_applied"],
      "properties": {
        "gate_result": {"enum": ["ALLOW", "REVIEW", "HALT"]},
        "gate_reasons": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "confidence_threshold_applied": {"type": "number", "minimum": 0, "maximum": 1},
        "high_impact_route": {"type": "boolean"},
        "allow_semantics": {"type": "string"}
      }
    },
    "recommendation": {
      "type": "object",
      "required": ["statement", "option_id", "kind"],
      "properties": {
        "statement": {"type": "string", "minLength": 10},
        "option_id": {"type": ["string", "null"]},
        "kind": {"enum": ["RECOMMENDATION", "NO_RECOMMENDATION", "HALT"]}
      }
    },
    "recommendation_binding_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "risks": {"type": "array", "items": {"type": "object"}},
    "authorization": {
      "type": "object",
      "required": ["status", "reason", "verifier", "verifier_is_authentic", "derived_from_confidence"],
      "properties": {
        "status": {"enum": ["NOT_REQUESTED", "PENDING_CASA", "VERIFICATION_UNAVAILABLE", "AUTHORIZED", "DENIED"]},
        "reason": {"type": "string", "minLength": 5},
        "verifier": {"type": "string"},
        "verifier_is_authentic": {"type": "boolean"},
        "authorization_id": {"type": ["string", "null"]},
        "issuer": {"type": ["string", "null"]},
        "nonce": {"type": ["string", "null"], "description": "Carried into the ledger so a later run can detect a replayed authorization."},
        "checks": {"type": "array", "items": {"type": "object"}},
        "derived_from_confidence": {"enum": [false]}
      }
    },
    "execution": {
      "type": "object",
      "required": ["execution_outcome", "execution_authorized", "recommendation_eligible", "authorization_status", "composition_rule"],
      "properties": {
        "execution_outcome": {"enum": ["MAY_PROCEED", "NOT_AUTHORIZED", "REVIEW", "HALT"]},
        "execution_authorized": {"type": "boolean"},
        "recommendation_eligible": {"type": "boolean"},
        "authorization_status": {"type": "string"},
        "composition_rule": {"type": "string"}
      }
    },
    "review_requirements": {"type": "array", "items": {"type": "string"}},
    "next_action": {"type": "string", "minLength": 10},
    "stage_chain": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "stage_chain_head": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "partial_execution": {"type": "array", "items": {"type": "object"}},
    "record_id": {"type": "string", "minLength": 5},
    "ledger_receipt": {"type": "object"}
  },
  "additionalProperties": false
}
