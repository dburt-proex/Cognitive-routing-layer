{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-record.schema.json",
  "title": "Reasoning Control Plane Evidence Record",
  "description": "One piece of evidence available to a run. verification_state is the field that separates declared evidence from verified evidence; the Cognitive Routing Layer records the declared state and never upgrades it on its own.",
  "type": "object",
  "required": ["evidence_id", "source_type", "source_id", "locator", "authority", "quality", "independence_group", "verification_state", "captured_at"],
  "properties": {
    "evidence_id": {"type": "string", "pattern": "^EV-[A-Za-z0-9-]+$"},
    "source_type": {"enum": ["repository", "document", "measurement", "interview", "vendor_claim", "test_result", "ledger_record", "external_publication", "human_attestation"]},
    "source_id": {"type": "string", "minLength": 1},
    "locator": {"type": "string", "minLength": 1},
    "authority": {"enum": ["authoritative", "corroborating", "indicative", "anecdotal"]},
    "quality": {"type": "number", "minimum": 0, "maximum": 100},
    "independence_group": {"type": "string", "minLength": 1},
    "verification_state": {"enum": ["UNVERIFIED", "SOURCE_IDENTIFIED", "RETRIEVED", "INTEGRITY_CHECKED", "AUTHORITATIVE", "CONFLICTED", "STALE"]},
    "captured_at": {"type": "string", "format": "date-time"},
    "claim_supported": {"type": "string"},
    "excerpt": {"type": "string"},
    "content_hash": {"type": ["string", "null"]},
    "conflicts_with": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "expires_at": {"type": ["string", "null"]},
    "human_attestation": {"type": ["string", "null"]},
    "untrusted_instruction_detected": {"type": "boolean"}
  },
  "additionalProperties": false
}
